{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": [],
    "pythonSources": [
      "{projectRoot}/bot.py",
      "{projectRoot}/config.py",
      "{projectRoot}/cogs/**/*.py",
      "{projectRoot}/requirements.txt",
      {
        "runtime": "python --version"
      }
    ],
    "pythonTests": [
      "pythonSources",
      "{projectRoot}/tests/**/*.py"
    ]
  },
  "analytics": false
}